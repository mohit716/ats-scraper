QWEN_API_KEY=your-alibaba-model-studio-key
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Cheap model: runs per page in LLM-only mode and on every hybrid fallback.
EXTRACT_MODEL=qwen-flash
# Strong model: runs once per page template to generate reusable selectors.
RULEGEN_MODEL=qwen-max
